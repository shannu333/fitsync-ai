# Backend Environment Configuration
PROJECT_NAME="RicePulse AP - Rice Crop Stress & Yield Prediction System"
API_V1_STR="/api/v1"
SECRET_KEY="ap_rice_farmers_secure_jwt_secret_key_change_in_production_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default with full PostgreSQL compatibility)
DATABASE_URL="sqlite:///./rice_stress_yield.db"

# Admin & State Specific Defaults
DEFAULT_STATE="Andhra Pradesh"
DEFAULT_LANGUAGE="Telugu"
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# ── Administrator Access Configuration ─────────────────────────────────────
